<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="96dp"
        android:paddingTop="48dp">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <EditText
            android:id="@+id/new_tab_search"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_search_pill"
            android:cursorVisible="true"
            android:hint="@string/search_or_enter_url"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingHorizontal="24dp"
            android:showSoftInputOnFocus="false"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/quick_launch_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <com.showfox.browser.ui.browser.OnScreenKeyboard
        android:id="@+id/on_screen_keyboard"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

</FrameLayout>
